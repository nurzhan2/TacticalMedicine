      \u0441\u044B\u0437\u044B\u0493\u044B."
  - id: needle_through_seal
    ru: "\u041D\u0435\u043B\u044C\u0437\u044F \u043A\u043E\u043B\u043E\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u043A\u043B\u0435\u0439\u043A\u0443."
    kz: "\u0416\u0430\u043F\u0441\u044B\u0440\u043C\u0430 \u0430\u0440\u049B\u044B\u043B\u044B
      \u0448\u0430\u043D\u0448\u0443\u0493\u0430 \u0431\u043E\u043B\u043C\u0430\u0439\u0434\u044B."
  - id: needle_angle
    ru: "\u0418\u0433\u043B\u0430 \u2014 \u043F\u0435\u0440\u043F\u0435\u043D\u0434\u0438\u043A\u0443\u043B\u044F\u0440\u043D\u043E
      \u0433\u0440\u0443\u0434\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043A\u0435."
    kz: "\u0418\u043D\u0435 \u2014 \u043A\u0435\u0443\u0434\u0435 \u049B\u0430\u0431\u044B\u0440\u0493\u0430\u0441\u044B\u043D\u0430
      \u043F\u0435\u0440\u043F\u0435\u043D\u0434\u0438\u043A\u0443\u043B\u044F\u0440."
  - id: needle_no_signs
    ru: "\u041D\u0435\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u043A\u043E\u0432
      \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u043F\u043D\u0435\u0432\u043C\u043E\u0442\u043E\u0440\u0430\u043A\u0441\u0430
      \u2014 \u0438\u0433\u043B\u0430 \u043D\u0435 \u043D\u0443\u0436\u043D\u0430."
    kz: "\u041A\u0435\u0440\u043D\u0435\u0443\u043B\u0456 \u043F\u043D\u0435\u0432\u043C\u043E\u0442\u043E\u0440\u0430\u043A\u0441
      \u0431\u0435\u043B\u0433\u0456\u0441\u0456 \u0436\u043E\u049B \u2014 \u0438\u043D\u0435
      \u043A\u0435\u0440\u0435\u043A \u0435\u043C\u0435\u0441."
  - id: npa_technique
    ru: "\u041D\u0424\u0412: \u0441\u0440\u0435\u0437 \u043A \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u043A\u0435,
      \u0432\u0432\u043E\u0434\u0438\u0442\u044C \xAB\u043A \u0437\u0435\u043C\u043B\u0435\xBB,
      \u043D\u0435 \u0432\u0432\u0435\u0440\u0445."
    kz: "\u041D\u0424\u0412: \u043A\u0435\u0441\u0456\u0433\u0456 \u049B\u0430\u043B\u049B\u0430\u0493\u0430,
      \xAB\u0436\u0435\u0440\u0433\u0435 \u049B\u0430\u0440\u0430\u0439\xBB \u0435\u043D\u0433\u0456\u0437."
  - id: left_supine
    ru: "\u0411\u0435\u0437 \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u044F \u043D\u0430
      \u0441\u043F\u0438\u043D\u0435 \u2014 \u044F\u0437\u044B\u043A \u043F\u0435\u0440\u0435\u043A\u0440\u043E\u0435\u0442
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u041D\u0430 \u0431\u043E\u043A!"
    kz: "\u0415\u0441\u0456 \u0436\u043E\u049B, \u0448\u0430\u043B\u049B\u0430\u0441\u044B\u043D\u0430\u043D
      \u2014 \u0442\u0456\u043B\u0456 \u0442\u044B\u043D\u044B\u0441\u0442\u044B
      \u0436\u0430\u0431\u0430\u0434\u044B. \u0411\u04AF\u0439\u0456\u0440\u0456\u043D\u0435!"
  - id: tq_slow
    ru: "\u0416\u0433\u0443\u0442 \u043F\u043E\u0434 \u043E\u0433\u043D\u0451\u043C
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D \u043F\u043E\u0437\u0436\u0435 60
      \u0441\u0435\u043A\u0443\u043D\u0434."
    kz: "\u041E\u049B \u0430\u0441\u0442\u044B\u043D\u0434\u0430 \u0436\u0433\u0443\u0442
      60 \u0441\u0435\u043A\u0443\u043D\u0434\u0442\u0430\u043D \u043A\u0435\u0448
      \u0441\u0430\u043B\u044B\u043D\u0434\u044B."
  - id: tq_not_marked
    ru: "\u041D\u0435 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u0438\u044F \u0436\u0433\u0443\u0442\u0430."
    kz: "\u0416\u0433\u0443\u0442 \u0441\u0430\u043B\u044B\u043D\u0493\u0430\u043D
      \u0443\u0430\u049B\u044B\u0442 \u0436\u0430\u0437\u044B\u043B\u043C\u0430\u0434\u044B."
  - id: missed_wound
    ru: "\u041F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u0430 \u0440\u0430\u043D\u0430
      \u2014 \u043D\u0443\u0436\u0435\u043D \u043F\u043E\u043B\u043D\u044B\u0439
      \u043E\u0441\u043C\u043E\u0442\u0440."
    kz: "\u0416\u0430\u0440\u0430 \u0431\u0430\u0439\u049B\u0430\u043B\u043C\u0430\u0434\u044B
      \u2014 \u0442\u043E\u043B\u044B\u049B \u0442\u0435\u043A\u0441\u0435\u0440\u0443
      \u043A\u0435\u0440\u0435\u043A."
  - id: hypothermia
    ru: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u043E\u0445\u043B\u0430\u0436\u0434\u0451\u043D
      \u2014 \u043D\u0435 \u0443\u043A\u0440\u044B\u0442 \u043E\u0434\u0435\u044F\u043B\u043E\u043C."
    kz: "\u0416\u0430\u0440\u0430\u043B\u044B \u0442\u043E\u04A3\u044B\u043F \u049B\u0430\u043B\u0434\u044B
      \u2014 \u043A\u04E9\u0440\u043F\u0435\u043C\u0435\u043D \u0436\u0430\u0431\u044B\u043B\u043C\u0430\u0434\u044B."
  - id: no_medevac
    ru: "\u042D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F \u043D\u0435 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u0430
      \u043F\u043E \u0440\u0430\u0446\u0438\u0438."
    kz: "\u042D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044F \u0440\u0430\u0446\u0438\u044F\u043C\u0435\u043D
      \u0441\u04B1\u0440\u0430\u043B\u043C\u0430\u0434\u044B."
  - id: player_exposed
    ru: "\u0412 \u043F\u043E\u043B\u043D\u044B\u0439 \u0440\u043E\u0441\u0442 \u043F\u043E\u0434
      \u043E\u0433\u043D\u0451\u043C \u2014 \u043C\u0435\u0434\u0438\u043A \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0446\u0435\u043B\u044C\u044E."
    kz: "\u041E\u049B \u0430\u0441\u0442\u044B\u043D\u0434\u0430 \u0442\u0456\u043A
      \u0442\u04B1\u0440\u0443 \u2014 \u043C\u0435\u0434\u0438\u043A \u0435\u043A\u0456\u043D\u0448\u0456
      \u043D\u044B\u0441\u0430\u043D\u0430\u0493\u0430 \u0430\u0439\u043D\u0430\u043B\u0430\u0434\u044B."
  - id: no_gloves
    ru: "\u0420\u0430\u0431\u043E\u0442\u0430 \u0431\u0435\u0437 \u043F\u0435\u0440\u0447\u0430\u0442\u043E\u043A."
    kz: "\u049A\u043E\u043B\u0493\u0430\u043F\u0441\u044B\u0437 \u0436\u04B1\u043C\u044B\u0441."
  - id: tq_loose
    ru: "\u0416\u0433\u0443\u0442 \u0437\u0430\u0442\u044F\u043D\u0443\u0442 \u0441\u043B\u0430\u0431\u043E
      \u2014 \u0434\u043E\u043A\u0440\u0443\u0442\u0438 \u0432\u043E\u0440\u043E\u0442\u043E\u043A."
    kz: "\u0416\u0433\u0443\u0442 \u04D9\u043B\u0441\u0456\u0437 \u0442\u0430\u0440\u0442\u044B\u043B\u0493\u0430\u043D
      \u2014 \u0431\u04B1\u0440\u0430\u0493\u044B\u0448\u0442\u044B \u0431\u04B1\u0440\u0430."
  - id: big_blood_loss
    ru: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435
      30% \u043A\u0440\u043E\u0432\u0438 \u2014 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0439
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    kz: "\u049A\u0430\u043D\u043D\u044B\u04A3 30%-\u0434\u0430\u043D \u0430\u0441\u0442\u0430\u043C\u044B
      \u0436\u043E\u0493\u0430\u043B\u0434\u044B \u2014 \u0442\u0435\u0437\u0456\u0440\u0435\u043A
      \u04D9\u0440\u0435\u043A\u0435\u0442 \u0435\u0442."
  - id: tq_not_rechecked
    ru: "\u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u043B\u043E\u043A\u0430 \u0436\u0433\u0443\u0442
      \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D."
    kz: "\u0421\u04AF\u0439\u0440\u0435\u0443\u0434\u0435\u043D \u043A\u0435\u0439\u0456\u043D
      \u0436\u0433\u0443\u0442 \u049B\u0430\u0439\u0442\u0430 \u0442\u0435\u043A\u0441\u0435\u0440\u0456\u043B\u043C\u0435\u0434\u0456."
